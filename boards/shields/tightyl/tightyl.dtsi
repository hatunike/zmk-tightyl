#include <dt-bindings/zmk/matrix_transform.h>

#include "tightyl-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* P0.06 */
            , <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* P0.08 */
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* P0.17 */
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* P0.20 */
            ;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";

        /* 12 logical columns: 6 left + 6 right */
        columns = <12>;
        rows = <4>;

        map = <
            /* LEFT — already verified */
            RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4) RC(0, 5)
            RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3) RC(1, 4) RC(1, 5)
            RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4) RC(2, 5)
                     RC(3, 1) RC(3, 2) RC(3, 3) RC(3, 4) RC(3, 5)

            /*
             * RIGHT
             *
             * Logical physical order:
             *
             * Y     U     I     O     P     BSPC
             * H     J     K     L     ;     '
             * N     M     ,     .     /     \
             * SPACE NUM   SYM   [     ]
             *
             * Right overlay has col-offset = 6.
             */

            /* physical top = matrix row 2 */
            RC(2, 6) RC(2, 7) RC(2, 9) RC(2, 8) RC(2, 10) RC(2, 11)

            /* physical home = matrix row 1 */
            RC(1, 6) RC(1, 7) RC(1, 9) RC(1, 8) RC(1, 10) RC(1, 11)

            /* physical bottom = matrix row 0 */
            RC(0, 6) RC(0, 7) RC(0, 9) RC(0, 8) RC(0, 10) RC(0, 11)

            /* thumb row */
            RC(3, 6) RC(3, 7) RC(3, 9) RC(3, 8) RC(3, 10)
        >;
    };
};
