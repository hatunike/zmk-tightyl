#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define FUNC 4

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * BASE
         *
         * LEFT                         RIGHT
         * TAB Q W E R T                '    ; K   L   J   H
         * ESC A S D F G                \    / ,   .   M   N
         * SHF Z X C V B                BSPC P I   O   U   Y
         *     MEH GUI ALT CTL ENT      SPC  ] SYM [   NUM
         */
        base_layer {
            bindings = <
                &kp TAB          &kp Q       &kp W       &kp E       &kp R       &kp T
                &lt NAV ESC      &kp A       &kp S       &kp D       &kp F       &kp G
                &kp LSHIFT       &kp Z       &kp X       &kp C       &kp V       &kp B
                                 &mt LC(LA(LSHIFT)) ESC
                                               &kp LGUI    &kp LALT    &kp LCTRL   &kp ENTER

                &kp SQT          &kp SEMI    &kp K       &kp L       &kp J       &kp H
                &kp BSLH         &kp FSLH    &kp COMMA   &kp DOT     &kp M       &kp N
                &kp BSPC         &kp P       &kp I       &kp O       &kp U       &kp Y
                &kp SPACE        &kp RBKT    &lt SYM RIGHT
                                                           &kp LBKT    &lt NUM LEFT
            >;
        };

        /*
         * NAV / EDITING
         *
         * Right-hand C2/C3 swapped exactly as on BASE.
         */
        nav_layer {
            bindings = <
                &kp TAB          &kp HOME    &kp HOME    &kp HOME    &kp HOME    &kp HOME
                &trans           &kp ESC     &kp BSPC    &sk LC(LSHIFT)
                                                           &kp LSHIFT &sk LC(LA(LS(LGUI)))
                &kp LSHIFT       &none       &none       &none       &trans      &trans
                                 &mt LC(LA(LSHIFT)) ESC
                                               &kp LGUI    &kp LALT    &kp LCTRL   &kp ENTER

                &kp ENTER        &kp BSPC    &kp UP      &kp RIGHT   &kp DOWN    &kp LEFT
                &kp DEL          &kp FSLH    &msc SCRL_DOWN
                                                           &msc SCRL_RIGHT
                                                                       &msc SCRL_UP
                                                                                   &msc SCRL_LEFT
                &kp BSPC         &kp END     &kp END     &kp END     &kp END     &kp END
                &kp SPACE        &mkp MB2    &kp DEL     &mkp MB1    &kp BSPC
            >;
        };

        /*
         * NUMBERS
         */
        num_layer {
            bindings = <
                &kp GRAVE        &kp N1      &kp N2      &kp N3      &kp N4      &kp N5
                &kp ESC          &kp N1      &kp N2      &kp N3      &kp N4      &kp N5
                &kp LSHIFT       &kp N1      &kp N2      &kp N3      &kp N4      &kp N5
                                 &trans       &trans       &trans       &trans       &trans

                &kp ENTER        &kp N0      &kp N8      &kp N9      &kp N7      &kp N6
                &kp DEL          &kp N0      &kp N8      &kp N9      &kp N7      &kp N6
                &kp BSPC         &kp EQUAL   &kp N8      &kp MINUS   &kp N7      &kp N6
                &trans           &kp RBKT    &trans      &kp LBKT    &trans
            >;
        };

        /*
         * SYMBOLS
         */
        sym_layer {
            bindings = <
                &kp TILDE        &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT
                &kp TILDE        &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT
                &kp TILDE        &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT
                                 &trans       &trans       &trans       &trans       &trans

                &kp PIPE         &kp RPAR    &kp STAR    &kp LPAR    &kp AMPS    &kp CARET
                &kp PIPE         &kp RPAR    &kp STAR    &kp LPAR    &kp AMPS    &kp CARET
                &kp BSPC         &kp PLUS    &kp STAR    &kp UNDER   &kp AMPS    &kp CARET
                &kp C_PLAY_PAUSE &kp RBRC    &trans      &kp LBRC    &trans
            >;
        };

        /*
         * FUNCTION / MEDIA / BOOTLOADER
         */
        func_layer {
            bindings = <
                &kp GRAVE        &kp F1      &kp F2      &kp F3      &kp F4      &kp F5
                &trans           &kp F1      &kp F2      &kp F3      &kp F4      &kp F5
                &trans           &kp F1      &kp F2      &kp F3      &kp F4      &kp F5
                                 &kp F12      &bootloader &kp C_VOL_DN
                                                           &kp C_VOL_UP
                                                                       &kp C_MUTE

                &kp F11          &kp F10     &kp F8      &kp F9      &kp F7      &kp F6
                &kp F11          &kp F10     &kp F8      &kp F9      &kp F7      &kp F6
                &trans           &kp F10     &kp F8      &kp F9      &kp F7      &kp F6
                &kp C_PLAY_PAUSE &kp C_VOL_UP
                                               &kp C_NEXT
                                                           &kp C_VOL_DN
                                                                       &kp C_PREV
            >;
        };
    };
};
